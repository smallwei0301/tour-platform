{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midao.local/schemas/toc-ownership-map.schema.json",
  "title": "Midao dump TOC ownership map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "expectedTocIds", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "expectedTocIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tocId", "objectKey", "ownerDomain"],
        "properties": {
          "tocId": { "type": "integer", "minimum": 1 },
          "objectKey": { "$ref": "#/$defs/key" },
          "ownerDomain": { "enum": ["application", "platform", "extension"] }
        }
      }
    }
  },
  "$defs": {
    "key": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean", "null"] } }
  }
}
