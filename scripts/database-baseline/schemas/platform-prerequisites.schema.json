{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midao.local/schemas/platform-prerequisites.schema.json",
  "title": "Midao platform-owned prerequisites",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "objects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objectKey", "provisionedBy", "required"],
        "properties": {
          "objectKey": { "$ref": "#/$defs/key" },
          "provisionedBy": { "type": "string", "minLength": 1 },
          "required": { "const": true }
        }
      }
    }
  },
  "$defs": {
    "key": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean", "null"] } }
  }
}
